# Copy to .env and fill in your values, or export these in your shell.

# Joplin Web Clipper API token
# Find it in Joplin -> Tools -> Options -> Web Clipper -> Authorization token
JOPLIN_TOKEN=<token from Joplin → Tools → Options → Web Clipper>

# Joplin API URL (default: http://localhost:41184)
# If running joplin-axi inside a container reaching a host-side Joplin instance,
# use host.docker.internal instead of localhost.
JOPLIN_BASE_URL=http://localhost:41184
